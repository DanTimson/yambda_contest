+    "        raise RuntimeError(\"Параметры этапа изменились. Выберите новый RUN_LABEL: \"+label)\n",
+    "    out = Path(record[\"out\"]) if record else RUNS/label\n",
+    "    if record and record.get(\"completed\") and (out/\"summary.json\").exists():\n",
