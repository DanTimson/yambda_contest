+    "                    .sum(dim=1)\n",
+    "                    .mean()\n",
+    "                )\n",
+    "                kl = (\n",
+    "                    -0.5 * (1 + logvar - mean.square() - logvar.exp()).sum(dim=1).mean()\n",
+    "                )\n",
+    "                loss = reconstruction + min(0.2, step / 2000) * kl\n",
+    "                if not torch.isfinite(loss):\n",
+    "                    raise ValueError(\"Non-finite MultVAE loss\")\n",
+    "                optimizer.zero_grad(set_to_none=True)\n",
+    "                loss.backward()\n",
+    "                optimizer.step()\n",
