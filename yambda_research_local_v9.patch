+    "def v9_top_scores(bank, row, scores, items, budget):\n",
+    "    count = min(budget, len(items))\n",
+    "    if not count:\n",
+    "        return\n",
+    "    columns = np.argpartition(scores, -count)[-count:]\n",
+    "    bank.set(row, items[columns], scores[columns])"
+   ]
