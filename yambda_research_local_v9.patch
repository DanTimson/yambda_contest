+    "            \"no_neural\",\n",
+    "            [\n",
+    "                name\n",
+    "                for name in all_features\n",
+    "                if not name.startswith((\"multvae_\", \"sasrec_\", \"two_tower_\"))\n",
+    "            ],\n",
