+    "                    similarities.max(axis=1),\n",
+    "                    similarities.mean(axis=1),\n",
+    "                ]\n",
+    "            )\n",
+    "            values[~known] = -2.0\n",
+    "        recent_features.append(values)\n",
+    "    return np.concatenate([source_features, scalars, *recent_features], axis=1).astype(\n",
+    "        np.float32\n",
+    "    )"
