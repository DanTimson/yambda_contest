+    "            values = (\n",
+    "                self.items(tokens) * 8\n",
+    "                + self.positions(torch.arange(tokens.shape[1], device=tokens.device))[\n",
+    "                    None, :, :\n",
+    "                ]\n",
+    "            )\n",
+    "            causal = torch.triu(\n",
+    "                torch.ones(\n",
+    "                    tokens.shape[1],\n",
+    "                    tokens.shape[1],\n",
+    "                    device=tokens.device,\n",
+    "                    dtype=torch.bool,\n",
+    "                ),\n",
+    "                diagonal=1,\n",
+    "            )\n",
