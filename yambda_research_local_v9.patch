+  exit 1
+fi
+mkdir -p eda_results
+ROCM_PATH="$rocm_dir" HIP_PATH="$rocm_dir" \
+  LD_PRELOAD="$hiprtc_path:$hip_path${LD_PRELOAD:+:$LD_PRELOAD}" \
+  .venv-catboost-rs-v9/bin/python tools/probe_catboost_rs_v9.py \
+    --expect rocm \
