+    "    if torch.cuda.is_available():\n",
+    "        torch.cuda.manual_seed_all(SEED)\n",
+    "    identity = dict(\n",
+    "        code=V9_CODE_SHA,\n",
+    "        versions=versions,\n",
+    "        source=parquet_source_identity(data / \"likes.parquet\"),\n",
+    "        cutoff=cut,\n",
