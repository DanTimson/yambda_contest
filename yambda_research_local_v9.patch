+    "        (\"new_pool_old_features\", \"als\", old_features, \"Logloss\", \"ips\", False),\n",
+    "        (\"new_pool_new_features\", \"als\", all_features, \"Logloss\", \"ips\", False),\n",
+    "        (\"quota_pool_logloss\", \"hybrid\", all_features, \"Logloss\", \"ips\", False),\n",
