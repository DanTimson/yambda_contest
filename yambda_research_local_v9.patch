+    "    negatives=0,\n",
+    "):\n",
+    "    log(f\"BUILD cutoff={cut}, labels=[{cut},{label_end}), users={len(users)}\")\n",
+    "    target = ctx.likes.filter(\n",
+    "        pl.col(\"uid\").is_in(users)\n",
