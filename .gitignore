!.env.template
*.pem
*.key
.netrc
.pypirc

# Downloaded data and Hugging Face caches (also ignore directory symlinks)
/data
/datasets
/downloads
/raw
/cache
/.cache
/hf_cache
/huggingface
/models
/checkpoints
wandb/
mlruns/
catboost_info/

# Large dataset, vector, model and archive files regardless of location
*.parquet
*.arrow
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.cbm
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
