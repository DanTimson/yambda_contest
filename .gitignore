# Generated model experiments, predictions and contest exports
/artifacts
/runs
/outputs
/submissions
/predictions
/results
/logs
*.log
submission*.csv
**/submission*.csv

# Keep the small supplied user list; ignore other CSVs in the input directory.
# Analysis CSV/JSON/HTML/SVG outside these paths remain trackable on purpose.
/input/*
!/input/test_users.csv
!/input/README.md
!/input/.gitkeep
/upload

# Jupyter checkpoints and editor/OS files; notebooks themselves remain trackable
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# EDA creates a compact review directory under eda_results/ which SHOULD be tracked.
# Ignore only its packaged duplicate; the rule above already ignores all ZIP archives.
# Avoid blanket *.csv / *.json / *.html / *.svg rules: those would hide the EDA evidence.
